
### 5. ملف `setup.py` للتثبيت

```python
from setuptools import setup, find_packages

with open("README.md", "r", encoding="utf-8") as fh:
    long_description = fh.read()

setup(
    name="pyrogram-session-generator",
    version="1.0.0",
    author="مبرمج عربي",
    author_email="your-email@example.com",
    description="مولد جلسات Pyrogram باللغة العربية",
    long_description=long_description,
    long_description_content_type="text/markdown",
    url="https://github.com/YourUsername/pyrogram-session-generator",
    packages=find_packages(),
    classifiers=[
        "Programming Language :: Python :: 3",
        "License :: OSI Approved :: MIT License",
        "Operating System :: OS Independent",
    ],
    python_requires=">=3.7",
    install_requires=[
        "pyrogram>=2.0.0",
        "tgcrypto>=1.2.3",
        "colorama>=0.4.6",
    ],
    entry_points={
        "console_scripts": [
            "session-gen=run:main",
        ],
    },
)
